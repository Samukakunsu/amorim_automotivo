# Copie este arquivo para ".env" (no computador) e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Na Vercel, cadastre as mesmas variáveis em
# Settings > Environment Variables.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# Domínio usado para transformar o "usuário" em e-mail no login.
# Exemplo: usuário "amorim" vira amorim@amorimpintura.app (é o e-mail que você cadastra no Supabase Auth).
VITE_DOMINIO_LOGIN=amorimpintura.app
